# ==========================================
# SANSONS - Environment Configuration
# ==========================================

# ------------------------------------------
# General
# ------------------------------------------
NODE_ENV=development

# ------------------------------------------
# API
# ------------------------------------------
PORT=3001
API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------
# Web Frontend
# ------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# ------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=sansons
DB_PASSWORD=sansons_secret
DB_NAME=sansons_db
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"

# ------------------------------------------
# Redis (BullMQ, Caching)
# ------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------
# JWT / Authentication
# ------------------------------------------
JWT_SECRET=super_secret_jwt_key_change_me
JWT_EXPIRATION=1d
REFRESH_TOKEN_SECRET=super_secret_refresh_key_change_me
REFRESH_TOKEN_EXPIRATION=7d

# ------------------------------------------
# External APIs (Placeholders)
# ------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SENDGRID_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
